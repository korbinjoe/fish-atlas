{
  "name": "fish-atlas",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run validate && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/validate-catalog.ts && tsx scripts/validate-photo-profiles.ts && tsx scripts/check-distribution-pins.ts",
    "catalog:refresh": "python3 scripts/import-catalog.py",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.0",
    "@radix-ui/react-select": "^2.4.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.180.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@types/topojson-client": "^3.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
